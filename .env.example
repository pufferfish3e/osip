# Copy to .env and add your key locally. Never expose it in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: allow photo analysis from a phone on a trusted private LAN.
# Set this to this computer's exact private IPv4 address and preview port.
# The default remains loopback-only. This is not production authentication.
# PLANT_ANALYSIS_ORIGIN=http://192.168.1.10:4173
